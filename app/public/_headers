# En-têtes HTTP servis par Cloudflare Pages (remplace vercel.json).
# ⚠️ Tout nouveau domaine externe (tuiles, mesure d'audience) doit être ajouté à la CSP.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=(), usb=(), browsing-topics=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; img-src 'self' data: blob: https://tile.openstreetmap.org https://*.tile.openstreetmap.org https://api.maptiler.com https://tiles.stadiamaps.com; connect-src 'self' https://cloudflareinsights.com https://tile.openstreetmap.org https://*.tile.openstreetmap.org https://api.maptiler.com https://tiles.stadiamaps.com; style-src 'self' 'unsafe-inline'; script-src 'self' https://static.cloudflareinsights.com; worker-src 'self' blob:; manifest-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache
  Content-Type: application/manifest+json

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/workbox-*
  Cache-Control: public, max-age=31536000, immutable

/data/*
  Cache-Control: public, max-age=60, must-revalidate

# Fond de carte : nom daté, change à chaque nouvelle version.
/carte/*
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/vnd.pmtiles
